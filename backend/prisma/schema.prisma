datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Core & Auth
model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  password  String
  name      String
  role      Role     @default(CASHIER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sales     Sale[]
  purchases Purchase[]
  logs      ActivityLog[]
}

enum Role { 
  ADMIN
  MANAGER
  CASHIER
}

model BusinessSettings {
  id             String  @id @default(auto()) @map("_id") @db.ObjectId
  companyName    String
  ownerName      String
  phone          String?
  email          String?
  address        String?
  taxPercentage  Float   @default(0)
  currency       String  @default("USD")
  invoicePrefix  String  @default("INV-")
  returnPolicy   String?
}

// Products & Inventory
model Category {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String    @unique
  description String?
  products    Product[]
}

model Product {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  sku           String   @unique
  categoryId    String   @db.ObjectId
  category      Category @relation(fields: [categoryId], references: [id])
  description   String?
  imageUrl      String?
  purchasePrice Float
  sellingPrice  Float
  stock         Int      @default(0)
  minStock      Int      @default(5)
  maxStock      Int?
  supplierId    String?  @db.ObjectId
  supplier      Supplier? @relation(fields: [supplierId], references: [id])
  status        String   @default("ACTIVE") // ACTIVE, ARCHIVED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  saleItems     SaleItem[]
  purchaseItems PurchaseItem[]
  transactions  InventoryTransaction[]
}

model InventoryTransaction {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  productId     String   @db.ObjectId
  product       Product  @relation(fields: [productId], references: [id])
  type          String   // IN, OUT, ADJUSTMENT
  quantity      Int
  previousStock Int
  newStock      Int
  reason        String
  userId        String?  @db.ObjectId
  createdAt     DateTime @default(now())
}

// CRM
model Customer {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  phone       String?
  email       String?
  address     String?
  notes       String?
  sales       Sale[]
  createdAt   DateTime @default(now())
}

model Supplier {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  companyName   String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  products      Product[]
  purchases     Purchase[]
}

// Transactions
model Sale {
  id            String     @id @default(auto()) @map("_id") @db.ObjectId
  invoiceNumber String     @unique
  customerId    String?    @db.ObjectId
  customer      Customer?  @relation(fields: [customerId], references: [id])
  userId        String     @db.ObjectId
  user          User       @relation(fields: [userId], references: [id])
  subtotal      Float
  taxAmount     Float
  discountAmount Float
  totalAmount   Float
  paymentMethod String     // CASH, CARD, TRANSFER
  amountPaid    Float
  change        Float
  status        String     // COMPLETED, REFUNDED
  items         SaleItem[]
  createdAt     DateTime   @default(now())
}

model SaleItem {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  saleId    String  @db.ObjectId
  sale      Sale    @relation(fields: [saleId], references: [id])
  productId String  @db.ObjectId
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Float
  total     Float
}

model Purchase {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  supplierId    String         @db.ObjectId
  supplier      Supplier       @relation(fields: [supplierId], references: [id])
  userId        String         @db.ObjectId
  user          User           @relation(fields: [userId], references: [id])
  totalAmount   Float
  status        String         // PENDING, RECEIVED, CANCELLED
  items         PurchaseItem[]
  createdAt     DateTime       @default(now())
}

model PurchaseItem {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  purchaseId String   @db.ObjectId
  purchase   Purchase @relation(fields: [purchaseId], references: [id])
  productId  String   @db.ObjectId
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Int
  unitPrice  Float
  total      Float
}

// Financials & Logging
model Expense {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  title         String
  category      String
  amount        Float
  description   String?
  paymentMethod String
  date          DateTime @default(now())
  addedById     String   @db.ObjectId
}

model ActivityLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  action    String
  entity    String
  details   String?
  createdAt DateTime @default(now())
}
